#!/bin/bash
# Uploads finished downloads to snow-leopard's ingest folder, then runs nas-media-import there.
# It needs root to chown the downloads, which belong to the downloader container, and uses sudo for that.
set -uo pipefail

REMOTE="hozzfozz@snow-leopard"
SOURCE_ROOT="/mnt/podman/vpn-downloader/.data/downloads/complete"
INGEST="/srv/media/ingest"
VIDEO_RE='.*\.\(mp4\|avi\|mkv\)$'

usage() {
  echo "Usage: $(basename "$0") -m | -s"
  echo "  -m    upload Movies (to ${INGEST}/movies)"
  echo "  -s    upload Shows (to ${INGEST}/shows)"
  exit 1
}

kind=""
while getopts "msh" opt; do
  case ${opt} in
    m) [[ -z ${kind} ]] || usage; kind=movies; src="${SOURCE_ROOT}/Movies" ;;
    s) [[ -z ${kind} ]] || usage; kind=shows; src="${SOURCE_ROOT}/Shows" ;;
    *) usage ;;
  esac
done
[[ -n ${kind} ]] || usage

# Run it as yourself; it restarts itself through sudo (by full path, since sudo ignores your PATH).
[[ ${EUID} -eq 0 ]] || exec sudo "$(readlink -f "$0")" "$@"
[[ -n ${SUDO_USER:-} ]] || { echo "Run this as your own user, not as root." >&2; exit 1; }

[[ -d ${src} ]] || { echo "Error: ${src} does not exist" >&2; exit 1; }
dest="${INGEST}/${kind}"

# Commands that talk to the server run as you, so ssh uses your Tailscale login and known_hosts.
as_user() { sudo -u "${SUDO_USER}" -H "$@"; }

echo "Processing ${src}"
# Only the items inside: the Movies/Shows folder itself must stay the downloader container's.
find "${src}" -mindepth 1 -maxdepth 1 -type d -exec chown -R "${SUDO_USER}:" {} +

uploaded=0
failed=()
skipped=()

for item in "${src}"/*/; do
  [[ -d ${item} ]] || continue
  item=${item%/}
  name=$(basename "${item}")
  echo
  echo "== ${name}"

  # Move every video up to the item's top folder, renaming on a clash, then delete everything else.
  while IFS= read -r -d '' video; do
    target="${item}/$(basename "${video}")"
    if [[ ${video} != "${target}" ]]; then
      base=${target%.*}; ext=${target##*.}; n=1
      while [[ -e ${target} ]]; do target="${base}_${n}.${ext}"; ((n++)); done
      mv "${video}" "${target}"
    fi
  done < <(find "${item}" -mindepth 2 -type f -iregex "${VIDEO_RE}" -print0)
  find "${item}" -type f ! -iregex "${VIDEO_RE}" -delete
  find "${item}" -mindepth 1 -type d -empty -delete

  if [[ -z $(find "${item}" -maxdepth 1 -type f -print -quit) ]]; then
    echo "No video files, left in place"
    skipped+=("${item}")
    continue
  fi

  # No trailing slash on the source, so rsync creates the item's folder on the server.
  if as_user rsync -a --partial --info=progress2 "${item}" "${REMOTE}:${dest}/"; then
    rm -rf "${item}"
    ((uploaded++))
  else
    failed+=("${item}")
  fi
done

echo
echo "Uploaded: ${uploaded}"
for f in "${skipped[@]}"; do echo "Skipped (no video): ${f}"; done
for f in "${failed[@]}"; do echo "FAILED: ${f}"; done

if ((uploaded > 0)); then
  # nas-media-import skips anything changed in the last 60 seconds, so wait that long first.
  echo
  echo "Waiting 60 seconds, then importing on the server (sudo asks for your password there)..."
  sleep 60
  as_user ssh -t "${REMOTE}" "sudo nas-media-import" || echo "Import left something in ${dest}; check the Status screen." >&2
fi

((${#failed[@]} == 0))
